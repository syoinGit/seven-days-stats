#!/bin/bash -p
# Install as root:root 0755 at /usr/local/sbin/rubinco-game-control.
# This is the privilege boundary. Keep all Docker arguments and container names here.
set -euo pipefail

deny() {
  printf '%s\n' 'Operation not permitted.' >&2
  exit 64
}

container_for() {
  case "$1" in
    7dtd) printf '%s' '7dtd' ;;
    terraria) printf '%s' 'terraria' ;;
    corekeeper) printf '%s' 'rubinco-corekeeper' ;;
    minecraft) printf '%s' 'rubinco-minecraft' ;;
    *) deny ;;
  esac
}

docker_local() {
  # Ignore the calling user's environment, contexts, credentials, and config directory.
  /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
    /usr/bin/docker --host=unix:///var/run/docker.sock "$@"
}

case "${1-}" in
  statuses)
    [[ $# == 1 ]] || deny
    available=0
    for game in 7dtd terraria corekeeper minecraft; do
      container="$(container_for "$game")"
      if state="$(docker_local inspect --type container --format '{{json .State}}' "$container")"; then
        available=$((available + 1))
      else
        # A missing/broken container must not hide the state of the other games.
        state='{"Status":"unavailable"}'
      fi
      printf '%s %s\n' "$game" "$state"
    done
    # Keep the deployment preflight failing when Docker is entirely unavailable.
    [[ "$available" -gt 0 ]]
    ;;
  status)
    [[ $# == 2 ]] || deny
    container="$(container_for "$2")"
    docker_local inspect --type container --format '{{json .State}}' "$container"
    ;;
  start)
    [[ $# == 2 ]] || deny
    case "$2" in 7dtd|corekeeper|minecraft) ;; *) deny ;; esac
    container="$(container_for "$2")"
    docker_local start "$container"
    ;;
  stop)
    [[ $# == 2 ]] || deny
    case "$2" in 7dtd|corekeeper|minecraft) ;; *) deny ;; esac
    container="$(container_for "$2")"
    # SIGTERM first so the game can save; Docker sends SIGKILL after the fixed grace period.
    docker_local stop --time 120 "$container"
    ;;
  logs)
    [[ $# == 2 && "$2" == 7dtd ]] || deny
    # exec allows sudo to forward shutdown signals to the streaming Docker client.
    exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
      /usr/bin/docker --host=unix:///var/run/docker.sock logs --follow --since 5m 7dtd
    ;;
  *) deny ;;
esac
