# Replace YOUR_GUILD_HOST and certificate paths. This is not an active deployment.
# Include alongside game-portal.conf (reuses upstream watchpoint_app).
server {
  listen 443 ssl;
  server_name YOUR_GUILD_HOST;
  ssl_certificate /etc/letsencrypt/live/YOUR_GUILD_HOST/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR_GUILD_HOST/privkey.pem;

  location = / { return 302 /guild; }
  # Keep administration on the existing authenticated portal host.
  location = /guild/maintenance { return 404; }
  location ^~ /guild/maintenance/ { return 404; }
  location ~ ^/(guild(?:/|$)|css/|img/|js/) {
    limit_except GET { deny all; }
    proxy_pass http://watchpoint_app;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  location / { return 404; }
}
