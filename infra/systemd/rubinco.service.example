[Unit]
Description=Rubinco game portal and Watchpoint
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/seven-days-stats
EnvironmentFile=/home/ec2-user/seven-days-stats/.env
ExecStartPre=/usr/bin/docker compose -f /home/ec2-user/seven-days-stats/compose.yml up -d postgres
ExecStart=/usr/bin/java -jar /home/ec2-user/seven-days-stats/app/app.jar --spring.profiles.active=production,cognito
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
