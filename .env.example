# Copy this file to .env on EC2 and fill in the secrets.
# The 7DTD server itself lives outside this Git repository.
POSTGRES_PASSWORD=
APP_ENVIRONMENT=production
SESSION_COOKIE_SECURE=true
SEVEN_DAYS_LOG_SOURCE=docker
SEVEN_DAYS_ROOT=/home/ec2-user/7dtd
SEVEN_DAYS_CONFIG_DIRECTORY=/home/ec2-user/7dtd/data
SEVEN_DAYS_DATA_DIRECTORY=/home/ec2-user/7dtd/data
SEVEN_DAYS_GAME_DIRECTORY=/home/ec2-user/7dtd/game
SEVEN_DAYS_IMPORT_STARTUP_ENABLED=true
SEVEN_DAYS_IMPORT_SCHEDULED_ENABLED=false
SEVEN_DAYS_CONTAINER_NAME=7dtd
SEVEN_DAYS_DOCKER_LOG_ENABLED=true
SEVEN_DAYS_DOCKER_LOG_SINCE=5m
SEVEN_DAYS_DOCKER_LOG_RESTART_DELAY_SECONDS=5
SEVEN_DAYS_LOG_SCHEDULED_ENABLED=false
SEVEN_DAYS_TELNET_ENABLED=true
SEVEN_DAYS_TELNET_HOST=127.0.0.1
SEVEN_DAYS_TELNET_PORT=8081
SEVEN_DAYS_TELNET_PASSWORD=
SEVEN_DAYS_TELNET_LP_INTERVAL_SECONDS=60
SEVEN_DAYS_TELNET_READ_TIMEOUT_MS=15000
SEVEN_DAYS_LOG_SERVER_METRIC_INTERVAL_MINUTES=1
SEVEN_DAYS_CURRENT_STATE_MAX_AGE_SECONDS=120
SEVEN_DAYS_POI_TRANSLATION_RESOURCE=classpath:poi-translations.csv
AI_COMMENT_EDITOR_KEY=
WATCHPOINT_BOOTSTRAP_LOGIN=admin
WATCHPOINT_BOOTSTRAP_PASSWORD=
WATCHPOINT_AI_ANALYSIS_WINDOW_MINUTES=30
WATCHPOINT_AI_ANALYSIS_MAX_EVENTS=60
WATCHPOINT_AI_SYSTEM_PROMPT_RESOURCE=classpath:prompts/watchpoint-system-prompt.txt
WATCHPOINT_AI_BEDROCK_ENABLED=false
WATCHPOINT_AI_AWS_REGION=ap-northeast-1
WATCHPOINT_AI_BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
WATCHPOINT_AI_MAX_OUTPUT_TOKENS=240
WATCHPOINT_AI_SCHEDULE_MINUTES=30
WATCHPOINT_AI_INITIAL_DELAY_MS=60000
WATCHPOINT_AI_MAX_POSTS_PER_DAY=10
WATCHPOINT_AI_DIARY_ENABLED=false
WATCHPOINT_AI_DIARY_CRON=0 15 20 * * *
SURVIVOR_KAREN_ENABLED=true
SURVIVOR_KAREN_POST_ENABLED=true
SURVIVOR_KAREN_IMAGE_ENABLED=false
SURVIVOR_KAREN_IMAGE_INTERVAL_DAYS=3
SURVIVOR_KAREN_POST_HOUR=12
SURVIVOR_KAREN_SCHEDULE_CRON=0 17 * * * *
WATCHPOINT_IMAGE_AWS_REGION=us-east-1
WATCHPOINT_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
WATCHPOINT_IMAGE_BUCKET=
WATCHPOINT_IMAGE_PREFIX=watchpoint/posts/survivor-karen
WATCHPOINT_IMAGE_PUBLIC_BASE_URL=
