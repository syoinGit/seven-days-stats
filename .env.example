# For local development, use .env.local.example instead.
# Required values for the production portal (production,cognito).
# scripts/run-app.sh and the systemd example select these profiles automatically.
# Ports, EC2 paths, site URLs, and feature defaults live in application*.yml.
# Optional overrides and AI/image settings: RUNNING.md, "Configuration overrides".
POSTGRES_PASSWORD=
SEVEN_DAYS_TELNET_PASSWORD=

# Copy these outputs from infra/cognito/template.yaml. Public clients have no secret.
COGNITO_ISSUER_URI=
COGNITO_PORTAL_CLIENT_ID=
COGNITO_WATCHPOINT_CLIENT_ID=
COGNITO_LUMINITE_CLIENT_ID=
